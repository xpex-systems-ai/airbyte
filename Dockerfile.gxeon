FROM python:3.12-alpine
WORKDIR /app
RUN printf '%s\n' 'import json, os' 'from http.server import BaseHTTPRequestHandler,HTTPServer' 'class H(BaseHTTPRequestHandler):' ' def out(self,c,o):' '  b=json.dumps(o).encode(); self.send_response(c); self.send_header("Content-Type","application/json"); self.send_header("Content-Length",str(len(b))); self.end_headers(); self.wfile.write(b)' ' def do_GET(self):' '  self.out(200,{"service":"GXEON-Ingestion","status":"ok","mode":"compatibility"}) if self.path in ("/","/health","/api/v1/saude") else self.out(404,{"error":"not_found"})' ' def do_POST(self):' '  n=int(self.headers.get("Content-Length","0")); raw=self.rfile.read(n); self.out(202,{"accepted":True,"bytes":len(raw),"next":"dify"}) if self.path=="/api/v1/ingest" else self.out(404,{"error":"not_found"})' 'HTTPServer(("0.0.0.0",int(os.environ.get("PORT","8080"))),H).serve_forever()' > server.py
CMD ["python","server.py"]
